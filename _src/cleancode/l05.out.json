{
"cat > shipping.py <<'EOF'\n# 运费模块\n# 作者：张三\n# 2023-01-05 创建\n# 2023-06-11 李四修改\n\n# 计算运费\ndef calc(w, r, vip):\n    # 如果是 vip\n    if vip:\n        # vip 免运费\n        return 0\n    # 基础运费\n    c = 8\n    # 超过 1 公斤，每公斤加 2 元\n    if w > 1:\n        c += (w - 1) * 2\n    # 偏远地区\n    if r in (\"XZ\", \"XJ\"):\n        # 偏远地区翻倍。物流合同第 4.2 条规定\n        c *= 2\n    # c = c * 1.06\n    return c\nEOF\npython3 -c \"from shipping import calc; print(calc(3, 'BJ', False), calc(3, 'XZ', False), calc(3, 'XJ', True))\"": "12 24 0",
"cat > shipping.py <<'EOF'\nBASE_FEE = 8\nINCLUDED_KG = 1\nFEE_PER_EXTRA_KG = 2\n# 物流合同第 4.2 条：西藏、新疆的运费为标准运费的两倍。\nREMOTE_REGIONS = {\"XZ\", \"XJ\"}\nREMOTE_MULTIPLIER = 2\n\ndef shipping_fee(weight_kg, region, is_vip):\n    \"\"\"返回一个包裹的运费（元）。VIP 免运费。\"\"\"\n    if is_vip:\n        return 0\n    fee = BASE_FEE + max(0, weight_kg - INCLUDED_KG) * FEE_PER_EXTRA_KG\n    if region in REMOTE_REGIONS:\n        fee *= REMOTE_MULTIPLIER\n    return fee\nEOF\npython3 -c \"from shipping import shipping_fee as f; print(f(3, 'BJ', False), f(3, 'XZ', False), f(3, 'XJ', True))\"": "12 24 0",
"grep -c \"#\" shipping.py; python3 -c \"import shipping; help(shipping.shipping_fee)\" | sed -n 3,4p": "1\nshipping_fee(weight_kg, region, is_vip)\n    返回一个包裹的运费（元）。VIP 免运费。"
