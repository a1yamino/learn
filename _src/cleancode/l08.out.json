"cat > cart.py <<'EOF'\nSTOCK = {\"pen\": 3, \"ink\": 0}\nCOUPONS = {\"SAVE10\": 0.1}\n\ndef reserve(sku, qty):\n    if sku not in STOCK:\n        return -1\n    if STOCK[sku] < qty:\n        return -2\n    STOCK[sku] -= qty\n    return 0\n\ndef coupon(code):\n    return COUPONS.get(code)  # 可能是 None\n\ndef checkout(sku, qty, price, code):\n    r = reserve(sku, qty)\n    if r == -1:\n        return \"unknown\"\n    if r == -2:\n        return \"out of stock\"\n    c = coupon(code)\n    return price * qty * (1 - c)\nEOF\npython3 -c \"\nfrom cart import checkout\nprint(checkout('pen', 1, 10, 'SAVE10'))\nprint(checkout('ink', 1, 10, 'SAVE10'))\nprint(checkout('pen', 1, 10, None))\"": "9.0\nout of stock\nTraceback (most recent call last):\n  File \"<string>\", line 5, in <module>\n    print(checkout('pen', 1, 10, None))\n          ~~~~~~~~^^^^^^^^^^^^^^^^^^^^\n  File \"cart.py\", line 22, in checkout\n    return price * qty * (1 - c)\n                          ~~^~~\nTypeError: unsupported operand type(s) for -: 'int' and 'NoneType'",
"cat > cart.py <<'EOF'\nfrom dataclasses import dataclass\n\nSTOCK = {\"pen\": 3, \"ink\": 0}\n\nclass CheckoutError(Exception):\n    pass\n\nclass UnknownProduct(CheckoutError):\n    pass\n\nclass OutOfStock(CheckoutError):\n    pass\n\n@dataclass(frozen=True)\nclass Coupon:\n    rate: float\n    def apply(self, amount):\n        return amount * (1 - self.rate)\n\nclass NoCoupon:\n    def apply(self, amount):\n        return amount\n\nCOUPONS = {\"SAVE10\": Coupon(0.1)}\n\ndef reserve(sku, qty):\n    if isinstance(qty, bool) or not isinstance(qty, int) or qty <= 0:\n        raise ValueError(\"数量必须为正整数\")\n    if sku not in STOCK:\n        raise UnknownProduct(f\"没有商品 {sku!r}\")\n    if STOCK[sku] < qty:\n        raise OutOfStock(f\"{sku} 库存 {STOCK[sku]}，需要 {qty}\")\n    STOCK[sku] -= qty\n\ndef coupon_for(code):\n    return COUPONS.get(code, NoCoupon())\n\ndef checkout(sku, qty, price, code=None):\n    total = coupon_for(code).apply(price * qty)\n    reserve(sku, qty)\n    return total\nEOF\npython3 -c \"\nfrom cart import *\nprint(checkout('pen', 1, 10, 'SAVE10'))\nprint(checkout('pen', 1, 10))\nfor args in [('ink', 1, 10), ('cap', 1, 10)]:\n    try:\n        checkout(*args)\n    except CheckoutError as e:\n        print(type(e).__name__, '-', e)\"": "9.0\n10\nOutOfStock - ink 库存 0，需要 1\nUnknownProduct - 没有商品 'cap'"
