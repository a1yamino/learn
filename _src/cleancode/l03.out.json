"cat > report.py <<'EOF'\ndef monthly_report(rows):\n    totals = {}\n    for line in rows:\n        parts = line.strip().split(\",\")\n        if len(parts) != 3:\n            continue\n        region, status, amount = parts\n        if status != \"paid\":\n            continue\n        totals[region] = totals.get(region, 0) + int(amount)\n    out = []\n    for region in sorted(totals):\n        cents = totals[region]\n        out.append(f\"{region:<6}{cents // 100:>8,}.{cents % 100:02d}\")\n    out.append(\"-\" * 17)\n    grand = sum(totals.values())\n    out.append(f\"{'total':<6}{grand // 100:>8,}.{grand % 100:02d}\")\n    return \"\\n\".join(out)\nEOF\ncat > test_report.py <<'EOF'\nimport unittest\nfrom report import monthly_report\nROWS = [\"north,paid,123456\\n\", \"south,paid,99\\n\", \"north,refunded,500\\n\", \"bad line\\n\", \"north,paid,1000\\n\"]\nEXPECTED = \"north    1,244.56\\nsouth        0.99\\n-----------------\\ntotal    1,245.55\"\nclass T(unittest.TestCase):\n    def test_report(self):\n        self.assertEqual(monthly_report(ROWS), EXPECTED)\nunittest.main(argv=[\"x\"], exit=False, verbosity=0)\nEOF\npython3 test_report.py && python3 longest.py report.py": "----------------------------------------------------------------------\nRan 1 test in 0.000s\n\nOK\n  18  report.py:monthly_report",
"cat > report.py <<'EOF'\nfrom typing import NamedTuple\n\nclass Payment(NamedTuple):\n    region: str\n    status: str\n    cents: int\n\ndef monthly_report(lines):\n    payments = parse_payments(lines)\n    totals = paid_totals_by_region(payments)\n    return render(totals)\n\ndef parse_payments(lines):\n    for line in lines:\n        parts = line.strip().split(\",\")\n        if len(parts) == 3:\n            region, status, amount = parts\n            yield Payment(region, status, int(amount))\n\ndef paid_totals_by_region(payments):\n    totals = {}\n    for p in payments:\n        if p.status == \"paid\":\n            totals[p.region] = totals.get(p.region, 0) + p.cents\n    return totals\n\ndef render(totals):\n    lines = [row(region, totals[region]) for region in sorted(totals)]\n    lines.append(\"-\" * 17)\n    lines.append(row(\"total\", sum(totals.values())))\n    return \"\\n\".join(lines)\n\ndef row(label, cents):\n    return f\"{label:<6}{format_money(cents):>11}\"\n\ndef format_money(cents):\n    return f\"{cents // 100:,}.{cents % 100:02d}\"\nEOF\npython3 test_report.py && python3 longest.py report.py": "----------------------------------------------------------------------\nRan 1 test in 0.000s\n\nOK\n   6  report.py:parse_payments\n   6  report.py:paid_totals_by_region\n   5  report.py:render\n   4  report.py:monthly_report\n   2  report.py:row\n   2  report.py:format_money",
