{
"cat > stepdown.py <<'EOF'\nimport ast, sys\n\ndef check(path):\n    tree = ast.parse(open(path).read())\n    defs = {n.name: n.lineno for n in tree.body if isinstance(n, ast.FunctionDef)}\n    first_caller = {}\n    for fn in tree.body:\n        if not isinstance(fn, ast.FunctionDef):\n            continue\n        for node in ast.walk(fn):\n            if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in defs:\n                first_caller.setdefault(node.func.id, fn.lineno)\n    for name, line in defs.items():\n        caller = first_caller.get(name)\n        if caller and caller > line:\n            print(f\"{path}:{line}: {name} 定义在调用者（第 {caller} 行）之前\")\n\ncheck(sys.argv[1])\nEOF\npython3 stepdown.py export.py": "export.py:1: _format_cell 定义在调用者（第 10 行）之前",
"cat > export.py <<'EOF'\n\"\"\"把订单导出为 CSV 文本。\"\"\"\n\n\ndef export_orders(orders):\n    return \"\\n\".join(_to_row(o) for o in orders)\n\n\ndef _to_row(order):\n    return \",\".join(_format_cell(v) for v in order)\n\n\ndef _format_cell(value):\n    return str(value).replace(\",\", \" \")\nEOF\npython3 stepdown.py export.py; echo \"检查通过: $?\"; python3 -c \"from export import export_orders; print(export_orders([(1, 'a,b'), (2, 'c')]))\"": "检查通过: 0\n1,a b\n2,c",
"command -v ruff >/dev/null && ruff format --check export.py || echo \"未安装 ruff，跳过\"": "未安装 ruff，跳过"
}