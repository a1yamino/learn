{
"cat > test_characterization.py <<'EOF'\nimport importlib, unittest\nimport order\n\nclass Characterization(unittest.TestCase):\n    def setUp(self):\n        importlib.reload(order)\n\n    def run_order(self, **d):\n        d.setdefault(\"email\", \"a@x.com\")\n        return order.process_order(d, True)\n\n    def test_simple(self):\n        self.assertEqual(self.run_order(items=[\"pen:2\"]), 25.0)\n\n    def test_vip_discount_above_200(self):\n        self.assertEqual(self.run_order(items=[\"pen:12\", \"ink:2\"], type=2), 199.5)\n\n    def test_coupon(self):\n        self.assertEqual(self.run_order(items=[\"pen:1\"], coupon=\"SAVE10\"), 2.5)\n\n    def test_coupon_never_negative(self):\n        self.assertEqual(self.run_order(items=[\"pad:0\"], coupon=\"SAVE10\"), 0)\n\n    def test_unknown_sku_currently_returns_minus_1(self):\n        self.assertEqual(self.run_order(items=[\"cap:1\"]), -1)\n\n    def test_out_of_stock_currently_returns_minus_2(self):\n        self.assertEqual(self.run_order(items=[\"ink:3\"]), -2)\n\n    def test_empty_currently_returns_none(self):\n        self.assertIsNone(self.run_order(items=[]))\n\n    def test_stock_is_reduced_and_email_sent(self):\n        self.run_order(items=[\"ink:2\"])\n        self.assertEqual(order.STOCK[\"ink\"], 0)\n        self.assertEqual(order.SENT, [(\"a@x.com\", \"订单金额 60.00\")])\n\nunittest.main(argv=[\"x\"], exit=False, verbosity=1)\nEOF\npython3 test_characterization.py 2>&1 | tail -n 3": "Ran 8 tests in 0.001s\n\nOK",
"cat > order_after.py <<'EOF'\nfrom dataclasses import dataclass\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom enum import Enum\nfrom typing import Protocol\n\n\n@dataclass(frozen=True, order=True)\nclass Money:\n    amount: Decimal\n\n    @classmethod\n    def of(cls, value):\n        return cls(Decimal(str(value)).quantize(Decimal(\"0.01\"), ROUND_HALF_UP))\n\n    def __add__(self, other): return Money.of(self.amount + other.amount)\n    def __sub__(self, other): return Money.of(max(self.amount - other.amount, Decimal(0)))\n    def times(self, factor): return Money.of(self.amount * Decimal(str(factor)))\n\nZERO = Money.of(0)\n\n\nclass OrderError(Exception): pass\nclass EmptyOrder(OrderError): pass\nclass UnknownProduct(OrderError): pass\nclass OutOfStock(OrderError): pass\n\n\nclass CustomerType(Enum):\n    REGULAR = 1\n    VIP = 2\n\n\n@dataclass(frozen=True)\nclass OrderLine:\n    sku: str\n    quantity: int\n\n\n@dataclass(frozen=True)\nclass OrderRequest:\n    lines: tuple\n    email: str\n    customer_type: CustomerType = CustomerType.REGULAR\n    coupon: str | None = None\n\n\n@dataclass(frozen=True)\nclass Quote:\n    request: OrderRequest\n    subtotal: Money\n    discount: Money\n\n    @property\n    def total(self):\n        return self.subtotal - self.discount\n\n\nclass Discount(Protocol):\n    def amount(self, request: OrderRequest, subtotal: Money) -> Money: ...\n\n\nVIP_DISCOUNT_MIN = Money.of(200)\nVIP_DISCOUNT_RATE = Decimal(\"0.05\")\n\nclass VipDiscount:\n    def amount(self, request, subtotal):\n        if request.customer_type is CustomerType.VIP and subtotal > VIP_DISCOUNT_MIN:\n            return subtotal.times(VIP_DISCOUNT_RATE)\n        return ZERO\n\n\nclass CouponDiscount:\n    def __init__(self, coupons):\n        self._coupons = coupons\n\n    def amount(self, request, subtotal):\n        return self._coupons.get(request.coupon, ZERO)\n\n\ndef parse_request(data):\n    lines = tuple(OrderLine(sku, int(qty)) for sku, qty in (i.split(\":\") for i in data.get(\"items\", [])))\n    if not lines:\n        raise EmptyOrder()\n    return OrderRequest(lines, data[\"email\"], CustomerType(data.get(\"type\", 1)), data.get(\"coupon\"))\n\n\ndef price(request, catalog, discounts):\n    subtotal = ZERO\n    for line in request.lines:\n        if line.sku not in catalog:\n            raise UnknownProduct(line.sku)\n        subtotal = subtotal + catalog[line.sku].times(line.quantity)\n    after_vip = subtotal - VipDiscount().amount(request, subtotal)\n    discount = (subtotal - after_vip) + sum((d.amount(request, after_vip) for d in discounts), ZERO)\n    return Quote(request, subtotal, discount)\n\n\ndef place(quote, stock, notify):\n    for line in quote.request.lines:\n        if stock[line.sku] < line.quantity:\n            raise OutOfStock(f\"{line.sku}: 需要 {line.quantity}，库存 {stock[line.sku]}\")\n    for line in quote.request.lines:\n        stock[line.sku] -= line.quantity\n    notify(quote.request.email, f\"订单金额 {quote.total.amount:.2f}\")\n    return quote.total\n\n\ndef process_order(data, *, catalog, stock, discounts, notify):\n    request = parse_request(data)\n    quote = price(request, catalog, discounts)\n    return place(quote, stock, notify)\nEOF\npython3 -c \"import ast; ast.parse(open('order_after.py').read()); print('ok')\"": "ok",
"cat > test_order.py <<'EOF'\nimport unittest\nfrom decimal import Decimal\nfrom order_after import *\n\nclass OrderTest(unittest.TestCase):\n    def setUp(self):\n        self.catalog = {\"pen\": Money.of(12.5), \"ink\": Money.of(30), \"pad\": Money.of(8)}\n        self.stock = {\"pen\": 20, \"ink\": 2, \"pad\": 0}\n        self.sent = []\n        self.discounts = [CouponDiscount({\"SAVE10\": Money.of(10)})]\n\n    def order(self, **data):\n        data.setdefault(\"email\", \"a@x.com\")\n        return process_order(data, catalog=self.catalog, stock=self.stock,\n                             discounts=self.discounts, notify=lambda to, text: self.sent.append((to, text)))\n\n    def test_simple(self):\n        self.assertEqual(self.order(items=[\"pen:2\"]), Money.of(25))\n\n    def test_vip_discount_above_200(self):\n        self.assertEqual(self.order(items=[\"pen:12\", \"ink:2\"], type=2), Money.of(199.5))\n\n    def test_coupon(self):\n        self.assertEqual(self.order(items=[\"pen:1\"], coupon=\"SAVE10\"), Money.of(2.5))\n\n    def test_coupon_never_negative(self):\n        self.assertEqual(self.order(items=[\"pad:0\"], coupon=\"SAVE10\"), ZERO)\n\n    def test_unknown_product(self):\n        self.assertRaises(UnknownProduct, self.order, items=[\"cap:1\"])\n\n    def test_out_of_stock_leaves_stock_untouched(self):\n        self.assertRaises(OutOfStock, self.order, items=[\"pen:1\", \"ink:3\"])\n        self.assertEqual(self.stock[\"pen\"], 20)\n\n    def test_empty(self):\n        self.assertRaises(EmptyOrder, self.order, items=[])\n\n    def test_stock_is_reduced_and_email_sent(self):\n        self.order(items=[\"ink:2\"])\n        self.assertEqual(self.stock[\"ink\"], 0)\n        self.assertEqual(self.sent, [(\"a@x.com\", \"订单金额 60.00\")])\n\nif __name__ == \"__main__\":\n    unittest.main(argv=[\"x\"], exit=False, verbosity=1)\nEOF\npython3 test_order.py 2>&1 | tail -n 3": "Ran 8 tests in 0.000s\n\nOK",
"cat > threshold.py <<'EOF'\nfrom dataclasses import dataclass\nfrom order_after import Money, ZERO\n\n@dataclass(frozen=True)\nclass ThresholdDiscount:\n    minimum: Money\n    off: Money\n\n    def amount(self, request, subtotal):\n        return self.off if subtotal >= self.minimum else ZERO\nEOF\npython3 -c \"\nfrom order_after import *\nfrom threshold import ThresholdDiscount\ndiscounts = [CouponDiscount({}), ThresholdDiscount(Money.of(300), Money.of(30))]\nstock = {'pen': 100}\nfor items in (['pen:20'], ['pen:30']):\n    total = process_order({'items': items, 'email': 'z@x.com'}, catalog={'pen': Money.of(12.5)},\n                          stock=stock, discounts=discounts, notify=lambda *a: None)\n    print(items, total.amount)\"": "['pen:20'] 250.00\n['pen:30'] 345.00",
"cat > longest.py <<'EOF'\nimport ast, sys\nfor path in sys.argv[1:]:\n    tree = ast.parse(open(path).read())\n    fns = [(n.end_lineno - n.lineno + 1, n.name) for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)]\n    longest = max(fns)\n    print(f\"{path:<16} 函数 {len(fns):>2} 个，最长 {longest[0]:>2} 行（{longest[1]}）\")\nEOF\npython3 longest.py order_before.py order_after.py; grep -c \"return -\\|return None\" order_before.py order_after.py": "order_before.py  函数  1 个，最长 30 行（process_order）\norder_after.py   函数 13 个，最长  9 行（price）\norder_before.py:3\norder_after.py:0"
