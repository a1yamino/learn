{
"cat > test_orders.py <<'EOF'\nimport unittest\nfrom orders import calc\n\nORDERS = [(1, 100, 1), (2, 300, 1), (3, 500, 0), (4, 200, 1)]\n\nclass TestCalc(unittest.TestCase):\n    def test_only_paid_orders_count(self):\n        self.assertEqual(calc([(1, 100, 0)], 1000), 0)\n\n    def test_discount_above_threshold(self):\n        self.assertAlmostEqual(calc([(1, 300, 1)], 250), 270)\n\n    def test_mixed(self):\n        self.assertAlmostEqual(calc(ORDERS, 250), 570)\n\n    def test_threshold_is_exclusive(self):\n        self.assertEqual(calc([(1, 250, 1)], 250), 250)\n\nif __name__ == \"__main__\":\n    unittest.main()\nEOF\npython3 -m unittest -v": "test_discount_above_threshold (test_orders.TestCalc.test_discount_above_threshold) ... ok\ntest_mixed (test_orders.TestCalc.test_mixed) ... ok\ntest_only_paid_orders_count (test_orders.TestCalc.test_only_paid_orders_count) ... ok\ntest_threshold_is_exclusive (test_orders.TestCalc.test_threshold_is_exclusive) ... ok\n\n----------------------------------------------------------------------\nRan 4 tests in 0.000s\n\nOK",
"cat > orders.py <<'EOF'\nfrom dataclasses import dataclass\n\nPAID = 1\nDISCOUNT_RATE = 0.9\n\n@dataclass(frozen=True)\nclass Order:\n    id: int\n    amount: float\n    status: int\n\n    @property\n    def is_paid(self):\n        return self.status == PAID\n\ndef total_of_paid_orders(orders, discount_threshold):\n    total = 0\n    for order in orders:\n        if not order.is_paid:\n            continue\n        if order.amount > discount_threshold:\n            total += order.amount * DISCOUNT_RATE\n        else:\n            total += order.amount\n    return total\n\ndef calc(rows, threshold):  # 兼容旧调用方，逐步迁移后删除\n    return total_of_paid_orders([Order(*r) for r in rows], threshold)\nEOF\npython3 -m unittest": "....\n----------------------------------------------------------------------\nRan 4 tests in 0.000s\n\nOK",
"python3 -c \"from orders import Order, total_of_paid_orders as t; print(t([Order(1, 300, 1), Order(2, 100, 0)], 250))\"": "270.0"
}