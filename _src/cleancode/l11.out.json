"cat > employee.py <<'EOF'\nclass Employee:\n    def __init__(self, name, rate, hours, db):\n        self.name, self.rate, self.hours, self.db = name, rate, hours, db\n\n    def calculate_pay(self):\n        return self.rate * min(self.hours, 40) + self.overtime()\n\n    def overtime(self):\n        return self.rate * 1.5 * max(0, self.hours - 40)\n\n    def report_hours(self):\n        return self.format_row()\n\n    def format_row(self):\n        return f\"{self.name:<8}{self.hours:>4}h\"\n\n    def save(self):\n        self.db[self.name] = (self.rate, self.hours)\n\n    def load(self):\n        self.rate, self.hours = self.db[self.name]\nEOF\npython3 cohesion.py employee.py": "Employee\n  calculate_pay      hours overtime rate\n  overtime           hours rate\n  report_hours       format_row\n  format_row         hours name\n  save               db hours name rate\n  load               db hours name rate",
"cat > employee.py <<'EOF'\nfrom dataclasses import dataclass\n\nSTANDARD_WEEK_HOURS = 40\nOVERTIME_MULTIPLIER = 1.5\n\n@dataclass(frozen=True)\nclass Employee:\n    name: str\n    rate: float\n    hours: float\n\nclass PayCalculator:\n    def pay(self, e):\n        regular = min(e.hours, STANDARD_WEEK_HOURS)\n        overtime = max(0, e.hours - STANDARD_WEEK_HOURS)\n        return e.rate * (regular + overtime * OVERTIME_MULTIPLIER)\n\nclass HourReporter:\n    def row(self, e):\n        return f\"{e.name:<8}{e.hours:>4}h\"\n\nclass EmployeeRepository:\n    def __init__(self, db):\n        self._db = db\n\n    def save(self, e):\n        self._db[e.name] = (e.rate, e.hours)\n\n    def load(self, name):\n        rate, hours = self._db[name]\n        return Employee(name, rate, hours)\nEOF\npython3 cohesion.py employee.py && python3 -c \"\nfrom employee import *\nrepo = EmployeeRepository({})\nrepo.save(Employee('ann', 100, 45))\nann = repo.load('ann')\nprint(PayCalculator().pay(ann)); print(HourReporter().row(ann))\"": "Employee\nPayCalculator\n  pay                \nHourReporter\n  row                \nEmployeeRepository\n  save               _db\n  load               _db\n4750.0\nann       45h"
