"cat > invoice.py <<'EOF'\nsent = []\n\ndef make_invoice(customer, items, discount, send, lines=[]):\n    total = 0\n    for name, price in items:\n        lines.append(f\"{name}: {price}\")\n        total += price\n    total = total * (1 - discount)\n    lines.append(f\"total: {total:.2f}\")\n    if send:\n        sent.append(customer)\n    return lines\nEOF\npython3 -c \"\nimport invoice\nprint(invoice.make_invoice('ann', [('pen', 10)], 0, False))\nprint(invoice.make_invoice('bob', [('ink', 20)], 0.1, True))\nprint(invoice.sent)\"": "['pen: 10', 'total: 10.00']\n['pen: 10', 'total: 10.00', 'ink: 20', 'total: 18.00']\n['bob']",
"cat > invoice.py <<'EOF'\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass LineItem:\n    name: str\n    price: float\n\n@dataclass(frozen=True)\nclass Invoice:\n    customer: str\n    items: tuple\n    discount: float = 0.0\n\n    def total(self):\n        return sum(i.price for i in self.items) * (1 - self.discount)\n\n    def lines(self):\n        return [f\"{i.name}: {i.price}\" for i in self.items] + [f\"total: {self.total():.2f}\"]\n\nclass Mailer:\n    def __init__(self):\n        self.sent = []\n\n    def send(self, invoice):\n        self.sent.append(invoice.customer)\nEOF\npython3 -c \"\nfrom invoice import *\nann = Invoice('ann', (LineItem('pen', 10),))\nbob = Invoice('bob', (LineItem('ink', 20),), discount=0.1)\nprint(ann.lines()); print(bob.lines())\nmailer = Mailer(); mailer.send(bob); print(mailer.sent)\"": "['pen: 10', 'total: 10.00']\n['ink: 20', 'total: 18.00']\n['bob']",
"python3 -c \"\nfrom invoice import *\ni = Invoice('c', (LineItem('a', 1),))\ntry:\n    i.discount = 0.5\nexcept Exception as e:\n    print(type(e).__name__)\"": "FrozenInstanceError"
