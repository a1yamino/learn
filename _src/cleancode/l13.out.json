"cat > orders.py <<'EOF'\nimport functools\n\ndef retry(times, on):\n    if type(times) is not int or times < 1:\n        raise ValueError(\"times 必须是至少为 1 的总尝试次数\")\n    def wrap(fn):\n        @functools.wraps(fn)\n        def inner(*args, **kwargs):\n            for attempt in range(1, times + 1):\n                try:\n                    return fn(*args, **kwargs)\n                except on as e:\n                    if attempt == times:\n                        raise\n                    print(f\"[retry] {fn.__name__} 失败 {type(e).__name__}，第 {attempt} 次重试\")\n        return inner\n    return wrap\n\nclass OrderService:\n    def __init__(self, orders, notifier):\n        self._orders = orders\n        self._notifier = notifier\n\n    def place(self, order_id, email):\n        self._orders.save(order_id)\n        self._notifier.notify(email, f\"订单 {order_id} 已提交\")\n\nclass InMemoryOrders:\n    def __init__(self):\n        self.saved = []\n    def save(self, order_id):\n        self.saved.append(order_id)\n\nclass FlakyNotifier:\n    \"\"\"教学模拟：前两次在发送前失败，第三次才发送。\"\"\"\n    def __init__(self):\n        self.calls = 0\n    @retry(times=3, on=(TimeoutError,))\n    def notify(self, email, text):\n        self.calls += 1\n        if self.calls < 3:\n            raise TimeoutError()\n        print(f\"-> {email}: {text}\")\n\ndef build_service():\n    return OrderService(InMemoryOrders(), FlakyNotifier())\nEOF\npython3 -c \"from orders import build_service; build_service().place(42, 'ann@example.com')\"": "[retry] notify 失败 TimeoutError，第 1 次重试\n[retry] notify 失败 TimeoutError，第 2 次重试\n-> ann@example.com: 订单 42 已提交",
