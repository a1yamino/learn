{
"cat > scratch/l06.ts <<'EOF'\nimport { Type } from \"@earendil-works/pi-ai\";\nimport { fauxAssistantMessage, fauxToolCall, registerFauxProvider, streamSimple } from \"@earendil-works/pi-ai/compat\";\nimport { runAgentLoop, type AgentLoopConfig } from \"@earendil-works/pi-agent-core\";\n\nconst faux = registerFauxProvider();\nconst echo = {\n  name: \"echo\", label: \"echo\", description: \"回显\", parameters: Type.Object({ s: Type.String() }),\n  execute: async (_id: string, p: { s: string }) => ({ content: [{ type: \"text\" as const, text: p.s }], details: {} }),\n};\n\nasync function run(title: string, responses: any[], extra: Partial<AgentLoopConfig> = {}) {\n  faux.setResponses(responses);\n  const log: string[] = [];\n  let requests = 0;\n  const config: AgentLoopConfig = {\n    model: faux.getModel(),\n    convertToLlm: (ms) => ms as any,\n    transformContext: async (ms) => { requests++; return ms; },\n    ...extra,\n  };\n  const msgs = await runAgentLoop(\n    [{ role: \"user\", content: \"开始\", timestamp: Date.now() }],\n    { systemPrompt: \"\", messages: [], tools: [echo] },\n    config,\n    (e) => { if (e.type.startsWith(\"turn\") || e.type.startsWith(\"agent\") || e.type === \"tool_execution_end\") log.push(e.type + (e.type === \"tool_execution_end\" ? (e.isError ? \"(错误)\" : \"(成功)\") : \"\")); },\n    undefined,\n    streamSimple,\n  );\n  console.log(`== ${title}：模型请求 ${requests} 次`);\n  console.log(\"   事件:\", log.join(\" → \"));\n  console.log(\"   新消息:\", msgs.map((m: any) => m.role + (m.stopReason ? `(${m.stopReason})` : \"\")).join(\", \"));\n}\n\nconst call = (s: string) => fauxAssistantMessage([fauxToolCall(\"echo\", { s })], { stopReason: \"toolUse\" });\nawait run(\"两次工具调用\", [call(\"a\"), call(\"b\"), fauxAssistantMessage(\"完成\")]);\nawait run(\"输出被截断\", [fauxAssistantMessage([fauxToolCall(\"echo\", { s: \"rm -rf /tm\" })], { stopReason: \"length\" }), fauxAssistantMessage(\"重来\")]);\nawait run(\"finishTurn 提前结束\", [call(\"a\"), call(\"b\"), fauxAssistantMessage(\"完成\")], { finishTurn: async () => ({ action: \"end\" }) });\nlet once = true;\nawait run(\"follow-up\", [fauxAssistantMessage(\"第一次回答\"), fauxAssistantMessage(\"第二次回答\")], {\n  getFollowUpMessages: async () => (once ? ((once = false), [{ role: \"user\", content: \"再说一次\", timestamp: Date.now() }]) : []),\n});\nEOF\nnode scratch/l06.ts": "== 两次工具调用：模型请求 3 次\n   事件: agent_start → turn_start → tool_execution_end(成功) → turn_end → turn_start → tool_execution_end(成功) → turn_end → turn_start → turn_end → agent_end\n   新消息: system, user, assistant(toolUse), toolResult, assistant(toolUse), toolResult, assistant(stop)\n== 输出被截断：模型请求 2 次\n   事件: agent_start → turn_start → tool_execution_end(错误) → turn_end → turn_start → turn_end → agent_end\n   新消息: system, user, assistant(length), toolResult, assistant(stop)\n== finishTurn 提前结束：模型请求 1 次\n   事件: agent_start → turn_start → tool_execution_end(成功) → turn_end → agent_end\n   新消息: system, user, assistant(toolUse), toolResult\n== follow-up：模型请求 2 次\n   事件: agent_start → turn_start → turn_end → turn_start → turn_end → agent_end\n   新消息: system, user, assistant(stop), user, assistant(stop)",
"awk '/^async function runLoop/{s=NR} s&&/^}/{print \"runLoop:\", NR-s+1, \"行\"; exit}' packages/agent/src/agent-loop.ts": "runLoop: 159 行"
