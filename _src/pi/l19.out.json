{
"cat > pi-mono/scratch/l19.sh <<'EOF'\n#!/bin/bash\n# 信任边界实验：项目扩展是否加载？危险命令谁来拦？\nROOT=\"$(cd .. && pwd)\"; CLI=\"node $ROOT/packages/coding-agent/dist/cli.js\"\nexport HOME=$(mktemp -d); W=$(mktemp -d)\n# 一个让模型执行 \"rm -rf build\" 的 faux 扩展\ncat > $W/faux.ts <<'TS'\nimport { fauxAssistantMessage, fauxToolCall, registerFauxProvider } from \"@earendil-works/pi-ai/compat\";\nexport default function (pi: any) {\n  const f = registerFauxProvider();\n  f.setResponses([\n    fauxAssistantMessage([fauxToolCall(\"bash\", { command: \"rm -rf build && echo 已删除\" })], { stopReason: \"toolUse\" }),\n    (ctx: any) => fauxAssistantMessage(\"工具结果：\" + JSON.stringify(ctx.messages.at(-1).content[0].text)),\n  ]);\n  pi.registerProvider(\"faux\", { baseUrl: \"http://localhost:0\", apiKey: \"k\", api: f.api,\n    models: f.models.map((m: any) => ({ ...m, reasoning: false, input: [\"text\"] })) });\n}\nTS\n# 被测项目：带一个项目扩展\nP=$W/project; mkdir -p $P/.pi/extensions $P/build\necho 'export default function () { console.error(\"!! 项目扩展被加载并执行了\"); }' > $P/.pi/extensions/hello.ts\ncd $P\nPI=\"$CLI --no-session -e $W/faux.ts --model faux/faux-1\"\necho \"== 1. 默认（非交互，无保存的决定）\"; $PI -p \"清理\" </dev/null; ls -d build 2>/dev/null || echo \"(build 已被删除)\"\nmkdir -p build\necho \"== 2. --approve：信任本项目\"; $PI --approve -p \"清理\" </dev/null\nmkdir -p build\necho \"== 3. 加载官方示例 permission-gate\"\n$PI -e $ROOT/packages/coding-agent/examples/extensions/permission-gate.ts -p \"清理\" </dev/null\nls -d build && echo \"(build 仍在)\"\nEOF\ncd pi-mono/scratch && bash l19.sh 2>&1": "== 1. 默认（非交互，无保存的决定）\n工具结果：\"已删除\\n\"\n(build 已被删除)\n== 2. --approve：信任本项目\n!! 项目扩展被加载并执行了\n工具结果：\"已删除\\n\"\n== 3. 加载官方示例 permission-gate\n工具结果：\"Dangerous command blocked (no UI for confirmation)\"\nbuild\n(build 仍在)"
}