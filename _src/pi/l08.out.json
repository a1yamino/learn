{
"cat > scratch/l08.ts <<'EOF'\nimport { Type } from \"@earendil-works/pi-ai\";\nimport { fauxAssistantMessage, fauxToolCall, registerFauxProvider, streamSimple } from \"@earendil-works/pi-ai/compat\";\nimport { Agent } from \"@earendil-works/pi-agent-core\";\n\nconst faux = registerFauxProvider();\nconst wait = {\n  name: \"wait\", label: \"wait\", description: \"等待\", parameters: Type.Object({}),\n  execute: async (_id: string, _p: {}, signal?: AbortSignal) => {\n    await new Promise<void>((r, j) => { const t = setTimeout(r, 200); signal?.addEventListener(\"abort\", () => { clearTimeout(t); j(new Error(\"被中止\")); }); });\n    return { content: [{ type: \"text\" as const, text: \"done\" }], details: {} };\n  },\n};\nconst user = (t: string) => ({ role: \"user\" as const, content: t, timestamp: Date.now() });\nconst text = (m: any) => (typeof m.content === \"string\" ? m.content : m.content.map((c: any) => c.text ?? `<${c.type}:${c.name}>`).join(\"\"));\n\nfunction makeAgent(mode: \"one-at-a-time\" | \"all\") {\n  faux.setResponses([fauxAssistantMessage([fauxToolCall(\"wait\", {})], { stopReason: \"toolUse\" }), ...Array.from({ length: 4 }, (_, i) => fauxAssistantMessage(`回复${i + 1}`))]);\n  return new Agent({ streamFn: streamSimple, steeringMode: mode,\n    initialState: { systemPrompt: \"\", model: faux.getModel(), thinkingLevel: \"off\", tools: [wait] } });\n}\n\nfor (const mode of [\"one-at-a-time\", \"all\"] as const) {\n  const agent = makeAgent(mode);\n  agent.subscribe((e) => { if (e.type === \"tool_execution_start\") { agent.steer(user(\"插话A\")); agent.steer(user(\"插话B\")); } });\n  await agent.prompt(\"开始\");\n  console.log(`== steeringMode=${mode}`);\n  console.log(\"  \", agent.state.messages.filter((m) => m.role !== \"system\").map((m) => `${m.role}:${text(m)}`).join(\" | \"));\n}\n\nconst agent = makeAgent(\"all\");\nagent.subscribe((e) => { if (e.type === \"tool_execution_start\") setTimeout(() => agent.abort(), 50); });\nconst run = agent.prompt(\"开始\");\ntry { await agent.prompt(\"再来一个\"); } catch (e) { console.log(\"== 运行中再次 prompt:\", (e as Error).message.slice(0, 60)); }\nawait run;\nconst last = agent.state.messages.at(-1) as any;\nconsole.log(\"== abort 后: 最后一条\", last.role, last.stopReason ?? \"\", \"| 工具结果:\", text(agent.state.messages.find((m) => m.role === \"toolResult\")));\nconsole.log(\"   isStreaming =\", agent.state.isStreaming);\nEOF\nnode scratch/l08.ts": "== steeringMode=one-at-a-time\n   user:开始 | assistant:<toolCall:wait> | toolResult:done | user:插话A | assistant:回复1 | user:插话B | assistant:回复2\n== steeringMode=all\n   user:开始 | assistant:<toolCall:wait> | toolResult:done | user:插话A | user:插话B | assistant:回复1\n== 运行中再次 prompt: Agent is already processing a prompt. Use steer() or followU\n== abort 后: 最后一条 assistant aborted | 工具结果: 被中止\n   isStreaming = false"
}