"mkdir -p pi-mono/scratch && cat > pi-mono/scratch/hello.ts <<'EOF'\nimport { Type } from \"@earendil-works/pi-ai\";\nimport { fauxAssistantMessage, fauxText, fauxToolCall, registerFauxProvider, streamSimple } from \"@earendil-works/pi-ai/compat\";\nimport { Agent } from \"@earendil-works/pi-agent-core\";\n\nconst faux = registerFauxProvider();\nfaux.setResponses([\n  fauxAssistantMessage([fauxText(\"我来算一下。\"), fauxToolCall(\"add\", { a: 2, b: 3 })], { stopReason: \"toolUse\" }),\n  fauxAssistantMessage(\"结果是 5。\"),\n]);\n\nconst add = {\n  name: \"add\", label: \"add\", description: \"两数相加\",\n  parameters: Type.Object({ a: Type.Number(), b: Type.Number() }),\n  execute: async (_id: string, p: { a: number; b: number }) =>\n    ({ content: [{ type: \"text\" as const, text: String(p.a + p.b) }], details: {} }),\n};\n\nconst agent = new Agent({\n  streamFn: streamSimple,\n  initialState: { systemPrompt: \"你是助手\", model: faux.getModel(), thinkingLevel: \"off\", tools: [add] },\n});\nagent.subscribe((e) => { if (e.type !== \"message_update\") console.log(\"事件\", e.type); });\nawait agent.prompt(\"2+3=?\");\nfor (const m of agent.state.messages) console.log(m.role.padEnd(10), JSON.stringify(m.content).slice(0, 70));\nEOF\ncd pi-mono/scratch && node hello.ts": "事件 agent_start\n事件 turn_start\n事件 message_start\n事件 message_end\n事件 message_start\n事件 message_end\n事件 tool_execution_start\n事件 tool_execution_end\n事件 message_start\n事件 message_end\n事件 turn_end\n事件 turn_start\n事件 message_start\n事件 message_end\n事件 turn_end\n事件 agent_end\nsystem     \"你是助手\"\nuser       [{\"type\":\"text\",\"text\":\"2+3=?\"}]\nassistant  [{\"type\":\"text\",\"text\":\"我来算一下。\"},{\"type\":\"toolCall\",\"id\":\"tool:1792662\ntoolResult [{\"type\":\"text\",\"text\":\"5\"}]\nassistant  [{\"type\":\"text\",\"text\":\"结果是 5。\"}]"
