{
"cat > scratch/l20.ts <<'EOF'\n// 毕业项目：fixbot —— 用 pi SDK 组装的迷你编码 agent\n// 组成：AgentSession（第 2–8 课）+ 内置 read/edit（第 9–10 课）+ 自定义工具 run_tests\n//      + tool_call 守卫（第 15 课）+ 自己写的极简“界面”（订阅事件，第 3/18 课）\nimport { Type } from \"@earendil-works/pi-ai\";\nimport { fauxAssistantMessage, fauxToolCall } from \"@earendil-works/pi-ai/compat\";\nimport { defineTool } from \"@earendil-works/pi-coding-agent\";\nimport { execFileSync } from \"node:child_process\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { fauxSession } from \"./faux-session.ts\";\n\nlet cwd = \"\";\n// 1. 自定义工具：运行测试，返回通过/失败与输出\nconst runTests = defineTool({\n  name: \"run_tests\", label: \"run_tests\", description: \"运行项目测试（node test.js），返回输出\",\n  parameters: Type.Object({}),\n  async execute() {\n    try {\n      const out = execFileSync(\"node\", [\"test.js\"], { cwd, encoding: \"utf8\", stdio: \"pipe\" });\n      return { content: [{ type: \"text\", text: \"PASS\\n\" + out }], details: { ok: true } };\n    } catch (e: any) {\n      return { content: [{ type: \"text\", text: \"FAIL\\n\" + (e.stdout + e.stderr).trim() }], details: { ok: false } };\n    }\n  },\n});\n\n// 2. 脚本化的“模型”：先跑测试 → 读代码 → 修改 → 再跑测试 → 总结；也会试图越权\nconst last = (ctx: any) => ctx.messages.at(-1).content[0].text as string;\nconst responses = [\n  fauxAssistantMessage([fauxToolCall(\"run_tests\", {})], { stopReason: \"toolUse\" }),\n  (ctx: any) => fauxAssistantMessage([fauxToolCall(\"read\", { path: \"math.js\" })], { stopReason: \"toolUse\" }),\n  (ctx: any) => {\n    const bug = last(ctx).includes(\"a - b\") ? \"a - b\" : \"?\";\n    return fauxAssistantMessage([\n      fauxToolCall(\"edit\", { path: \"math.js\", edits: [{ oldText: bug, newText: \"a + b\" }] }),\n      fauxToolCall(\"bash\", { command: \"git push --force\" }),\n    ], { stopReason: \"toolUse\" });\n  },\n  fauxAssistantMessage([fauxToolCall(\"run_tests\", {})], { stopReason: \"toolUse\" }),\n  (ctx: any) => fauxAssistantMessage(`修好了：add 把减号改成加号。测试结果：${last(ctx).split(\"\\n\")[0]}`),\n];\n\nconst { session, dir } = await fauxSession(responses, {\n  files: {\n    \"math.js\": \"export function add(a, b) {\\n  return a - b;\\n}\\n\",\n    \"test.js\": 'import { add } from \"./math.js\";\\nif (add(2, 3) !== 5) { console.error(`add(2,3) = ${add(2, 3)}，期望 5`); process.exit(1); }\\nconsole.log(\"1 passed\");\\n',\n    \"package.json\": '{ \"type\": \"module\" }\\n',\n  },\n  extra: { customTools: [runTests], tools: [\"read\", \"edit\", \"bash\", \"run_tests\"] },\n});\ncwd = dir;\n\n// 3. 守卫：只允许测试与只读命令；在会话层拦截（与 permission-gate 同一机制）\n//    先保存会话自己安装的钩子（它负责调用扩展的 tool_call 处理器），再串联\nconst inner = session.agent.beforeToolCall;\nsession.agent.beforeToolCall = async (ctx: any, signal?: AbortSignal) =>\n  ctx.toolCall.name === \"bash\" ? { block: true, reason: \"fixbot 不允许执行 bash\" } : inner?.(ctx, signal);\n\n// 4. 极简界面：把事件流打印成一行行日志\nsession.subscribe((e: any) => {\n  if (e.type === \"tool_execution_start\") console.log(`→ ${e.toolName} ${JSON.stringify(e.args)}`);\n  if (e.type === \"tool_execution_end\")\n    console.log(`  ${e.isError ? \"✗\" : \"✓\"} ${JSON.stringify(e.result.content[0]?.text ?? \"\").slice(0, 70)}`);\n  if (e.type === \"message_end\" && e.message.role === \"assistant\" && e.message.stopReason === \"stop\")\n    console.log(`fixbot: ${e.message.content[0].text}`);\n});\n\nawait session.prompt(\"测试挂了，请修复\");\nconsole.log(\"--- 修复后的 math.js ---\\n\" + readFileSync(join(dir, \"math.js\"), \"utf8\").trim());\nconsole.log(`--- 会话共 ${session.messages.length} 条消息，${session.messages.filter((m: any) => m.role === \"toolResult\").length} 次工具调用`);\nsession.dispose();\nEOF\nnode scratch/l20.ts": "→ run_tests {}\n  ✓ \"FAIL\\nadd(2,3) = -1，期望 5\"\n→ read {\"path\":\"math.js\"}\n  ✓ \"export function add(a, b) {\\n  return a - b;\\n}\\n\"\n→ edit {\"path\":\"math.js\",\"edits\":[{\"oldText\":\"a - b\",\"newText\":\"a + b\"}]}\n→ bash {\"command\":\"git push --force\"}\n  ✗ \"fixbot 不允许执行 bash\"\n  ✓ \"Successfully replaced 1 block(s) in math.js.\"\n→ run_tests {}\n  ✓ \"PASS\\n1 passed\\n\"\nfixbot: 修好了：add 把减号改成加号。测试结果：PASS\n--- 修复后的 math.js ---\nexport function add(a, b) {\n  return a + b;\n}\n--- 会话共 12 条消息，5 次工具调用"
}