"cat > scratch/l17.ts <<'EOF'\nimport { Text, TuiMainScreen } from \"@earendil-works/pi-tui\";\nimport { VirtualTerminal } from \"../packages/tui/test/virtual-terminal.ts\";\n\nconst term = new VirtualTerminal(40, 10);\nlet written = \"\";\nconst origWrite = term.write.bind(term);\nterm.write = (d: string) => { written += d; origWrite(d); };\n\nconst tui = new TuiMainScreen(term);\nconst header = new Text(\"pi 课程：TUI 演示\");\nconst status = new Text(\"状态：思考中\");\nconst body = new Text(\"第 1 行\\n第 2 行\\n第 3 行\");\ntui.addChild(header); tui.addChild(body); tui.addChild(status);\ntui.start();\n\nconst show = (label: string) => {\n  const esc = written.replace(/\\x1b\\[\\?2026[hl]/g, (m) => (m.endsWith(\"h\") ? \"⟦同步开始⟧\" : \"⟦同步结束⟧\")).replace(/\\x1b/g, \"ESC\").replace(/\\r\\n/g, \"↵\");\n  console.log(`== ${label}：写入 ${Buffer.byteLength(written)} 字节\\n   ${esc.slice(0, 150)}${esc.length > 150 ? \"…\" : \"\"}`);\n  written = \"\";\n};\n\ntui.renderNow(); show(\"首次渲染（全部输出）\");\nstatus.setText(\"状态：调用工具 read\"); tui.renderNow(); show(\"只改最后一行\");\ntui.renderNow(); show(\"没有变化\");\nheader.setText(\"pi 课程：TUI 演示（已更新）\"); tui.renderNow(); show(\"改第一行（只重绘变化的区间）\");\n\nawait new Promise((r) => setTimeout(r, 50));\nconsole.log(\"\\n屏幕内容：\\n\" + (await term.flushAndGetViewport()).map((l: string) => \"  |\" + l.trimEnd()).filter((l: string) => l !== \"  |\").join(\"\\n\"));\ntui.stop();\nEOF\nnode scratch/l17.ts": "== 首次渲染（全部输出）：写入 603 字节\n   ⟦同步开始⟧                                        ESC[0mESC]8;;\u0007↵ pi 课程：TUI 演示                      ESC[0mESC]8;;\u0007↵                                       …\n== 只改最后一行：写入 82 字节\n   ⟦同步开始⟧ESC[1A\nESC[2K 状态：调用工具 read                    ESC[0mESC]8;;\u0007⟦同步结束⟧\n== 没有变化：写入 0 字节\n   \n== 改第一行（只重绘变化的区间）：写入 85 字节\n   ⟦同步开始⟧ESC[8A\nESC[2K pi 课程：TUI 演示（已更新）            ESC[0mESC]8;;\u0007⟦同步结束⟧\n\n屏幕内容：\n  | pi 课程：TUI 演示（已更新）\n  | 第 1 行\n  | 第 2 行\n  | 第 3 行\n  | 状态：调用工具 read"
