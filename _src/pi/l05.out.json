{
"cat > scratch/l05.ts <<'EOF'\n// 一个假的 Chat Completions 服务器 + pi-ai 的 openai-completions 适配器\nimport { createServer } from \"node:http\";\nimport { createProvider, envApiKeyAuth, InMemoryCredentialStore } from \"@earendil-works/pi-ai\";\nimport { openAICompletionsApi } from \"@earendil-works/pi-ai/api/openai-completions.lazy\";\nimport { builtinModels } from \"@earendil-works/pi-ai/providers/all\";\n\nconst chunks = [\n  { delta: { role: \"assistant\", content: \"我看\" } },\n  { delta: { content: \"一下。\" } },\n  { delta: { tool_calls: [{ index: 0, id: \"call_1\", type: \"function\", function: { name: \"read\", arguments: \"{\\\"pa\" } }] } },\n  { delta: { tool_calls: [{ index: 0, function: { arguments: \"th\\\":\\\"a.txt\\\"}\" } }] } },\n  { delta: {}, finish_reason: process.argv[2] ?? \"tool_calls\" },\n];\nconst server = createServer((req, res) => {\n  let body = \"\";\n  req.on(\"data\", (d) => (body += d));\n  req.on(\"end\", () => {\n    const j = JSON.parse(body);\n    console.log(\"[服务器收到] model=%s stream=%s\", j.model, j.stream);\n    for (const m of j.messages) console.log(\"   \", m.role.padEnd(9), JSON.stringify(m.content ?? m.tool_calls).slice(0, 60));\n    console.log(\"    tools:\", j.tools?.map((t: any) => t.function.name).join(\",\"));\n    res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n    for (const c of chunks) res.write(`data: ${JSON.stringify({ id: \"x\", object: \"chat.completion.chunk\", model: \"tiny\", choices: [{ index: 0, ...c }] })}\\n\\n`);\n    res.end(\"data: [DONE]\\n\\n\");\n  });\n});\nawait new Promise<void>((r) => server.listen(0, \"127.0.0.1\", r));\nconst baseUrl = `http://127.0.0.1:${(server.address() as any).port}/v1`;\n\nconst models = builtinModels({ credentials: new InMemoryCredentialStore() });\nmodels.setProvider(createProvider({\n  id: \"local\", name: \"Local\", baseUrl,\n  auth: { apiKey: envApiKeyAuth(\"key\", [\"LOCAL_KEY\"]) },\n  models: [{ id: \"tiny\", name: \"tiny\", api: \"openai-completions\", provider: \"local\", baseUrl, reasoning: false,\n    input: [\"text\"], cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 8192, maxTokens: 1024 }],\n  api: openAICompletionsApi(),\n}));\nprocess.env.LOCAL_KEY = \"k\";\n\nconst s = models.streamSimple(models.getModel(\"local\", \"tiny\")!, {\n  systemPrompt: \"你是助手\",\n  messages: [{ role: \"user\", content: \"a.txt 里有什么？\", timestamp: Date.now() }],\n  tools: [{ name: \"read\", description: \"读文件\", parameters: { type: \"object\", properties: { path: { type: \"string\" } } } as any }],\n});\nfor await (const e of s) if (e.type !== \"start\") console.log(\"[事件]\", e.type, \"delta\" in e ? JSON.stringify(e.delta) : \"\");\nconst m = await s.result();\nconsole.log(\"stopReason=%s rawStopReason=%s\", m.stopReason, m.rawStopReason, m.errorMessage ?? \"\");\nconsole.log(\"toolCall:\", JSON.stringify(m.content.find((c) => c.type === \"toolCall\")));\nserver.close();\nEOF\nnode scratch/l05.ts": "[服务器收到] model=tiny stream=true\n    system    \"你是助手\"\n    user      \"a.txt 里有什么？\"\n    tools: read\n[事件] text_start\n[事件] text_delta \"我看\"\n[事件] text_delta \"一下。\"\n[事件] toolcall_start\n[事件] toolcall_delta \"{\\\"pa\"\n[事件] toolcall_delta \"th\\\":\\\"a.txt\\\"}\"\n[事件] text_end\n[事件] toolcall_end\n[事件] done\nstopReason=toolUse rawStopReason=tool_calls\ntoolCall: {\"type\":\"toolCall\",\"id\":\"call_1\",\"name\":\"read\",\"arguments\":{\"path\":\"a.txt\"}}",
"node scratch/l05.ts content_filter | tail -3": "[事件] error\nstopReason=error rawStopReason=content_filter Provider finish_reason: content_filter\ntoolCall: {\"type\":\"toolCall\",\"id\":\"call_1\",\"name\":\"read\",\"arguments\":{\"path\":\"a.txt\"}}"
}
