"cat > scratch/l11.ts <<'EOF'\nimport { mkdtempSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { createBashTool } from \"@earendil-works/pi-coding-agent\";\n\nconst dir = mkdtempSync(join(tmpdir(), \"l11-\"));\nconst bash = createBashTool(dir);\nconst short = (t: string) => t.replace(/\\/tmp\\/[^\\s\\]]+/g, \"<临时文件>\");\n\nasync function run(title: string, args: any, opts: { abortAfter?: number; updates?: boolean } = {}) {\n  const ac = new AbortController();\n  if (opts.abortAfter) setTimeout(() => ac.abort(), opts.abortAfter);\n  let n = 0;\n  const t = performance.now();\n  try {\n    const r: any = await bash.execute(\"id\", args, ac.signal, opts.updates ? () => { n++; } : undefined);\n    const lines = r.content[0].text.split(\"\\n\");\n    console.log(`== ${title}${r.isError ? \"（isError）\" : \"\"}`);\n    console.log(\"  \" + (lines.length > 5 ? [lines[0], \"  …\", ...lines.slice(-3)] : lines).map(short).join(\"\\n  \"));\n    if (r.structuredContent) console.log(`  structured: exit_code=${r.structuredContent.exit_code} truncated=${r.structuredContent.truncated}`);\n  } catch (e) {\n    console.log(`== ${title}（抛出）\\n  ` + short((e as Error).message).split(\"\\n\").join(\"\\n  \"));\n  }\n  console.log(`  用时约 ${Math.round((performance.now() - t) / 100) / 10}s` + (opts.updates ? `，收到部分输出更新 ${n > 1 ? \"多\" : n} 次` : \"\"));\n}\n\nawait run(\"成功\", { command: \"echo hi; echo err >&2\" });\nawait run(\"非零退出码\", { command: \"ls /nope\" });\nawait run(\"大量输出\", { command: \"seq 1 5000\" });\nawait run(\"超时\", { command: \"echo start; sleep 5\", timeout: 1 });\nawait run(\"中止（含子进程）\", { command: \"sleep 30 & sleep 30; echo never\" }, { abortAfter: 300 });\nawait run(\"流式更新\", { command: \"for i in 1 2 3; do echo $i; sleep 0.3; done\" }, { updates: true });\nEOF\nnode scratch/l11.ts": "== 成功\n  hi\n  err\n  \n  structured: exit_code=0 truncated=false\n  用时约 0s\n== 非零退出码（isError）\n  ls: cannot access '/nope': No such file or directory\n  \n  \n  Command exited with code 2\n  structured: exit_code=2 truncated=false\n  用时约 0s\n== 大量输出\n  3001\n    …\n  5000\n  \n  [Showing lines 3001-5000 of 5000. Full output: <临时文件>]\n  structured: exit_code=0 truncated=false\n  用时约 0s\n== 超时（抛出）\n  start\n  \n  \n  Command timed out after 1 seconds\n  用时约 1s\n== 中止（含子进程）（抛出）\n  Command aborted\n  用时约 0.3s\n== 流式更新\n  1\n  2\n  3\n  \n  structured: exit_code=0 truncated=false\n  用时约 0.9s，收到部分输出更新 多 次"
