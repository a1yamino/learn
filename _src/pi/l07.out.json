{
"cat > scratch/l07.ts <<'EOF'\nimport { Type } from \"@earendil-works/pi-ai\";\nimport { fauxAssistantMessage, fauxToolCall, registerFauxProvider, streamSimple } from \"@earendil-works/pi-ai/compat\";\nimport { runAgentLoop, type AgentLoopConfig } from \"@earendil-works/pi-agent-core\";\n\nconst faux = registerFauxProvider();\nconst t0 = () => performance.now();\nlet start = 0;\nconst at = () => `${Math.round((performance.now() - start) / 100) * 100}ms`;\nconst sleep = {\n  name: \"sleep\", label: \"sleep\", description: \"等待\", parameters: Type.Object({ ms: Type.Number() }),\n  execute: async (_id: string, p: { ms: number }) => {\n    console.log(`   [${at()}] sleep(${p.ms}) 开始`);\n    await new Promise((r) => setTimeout(r, p.ms));\n    console.log(`   [${at()}] sleep(${p.ms}) 结束`);\n    return { content: [{ type: \"text\" as const, text: \"ok\" }], details: {} };\n  },\n};\nconst sh = {\n  name: \"sh\", label: \"sh\", description: \"执行命令\", parameters: Type.Object({ cmd: Type.String() }),\n  execute: async (_id: string, p: { cmd: string }) => ({ content: [{ type: \"text\" as const, text: `(执行了 ${p.cmd})` }], details: {} }),\n};\n\nasync function run(title: string, calls: [string, any][], extra: Partial<AgentLoopConfig> = {}) {\n  console.log(\"==\", title);\n  faux.setResponses([fauxAssistantMessage(calls.map(([n, a]) => fauxToolCall(n, a)), { stopReason: \"toolUse\" }), fauxAssistantMessage(\"好\")]);\n  start = t0();\n  const msgs = await runAgentLoop([{ role: \"user\", content: \"go\", timestamp: Date.now() }],\n    { systemPrompt: \"\", messages: [], tools: [sleep, sh] },\n    { model: faux.getModel(), convertToLlm: (m) => m as any, ...extra }, () => {}, undefined, streamSimple);\n  for (const m of msgs as any[]) if (m.role === \"toolResult\") console.log(`   结果 ${m.toolName}: ${m.isError ? \"错误 \" : \"\"}${m.content[0].text.replace(/\\n/g, \" ⏎ \").slice(0, 80)}`);\n  console.log(`   总耗时约 ${at()}`);\n}\n\nawait run(\"并行（默认）\", [[\"sleep\", { ms: 300 }], [\"sleep\", { ms: 200 }]]);\nawait run(\"顺序执行\", [[\"sleep\", { ms: 300 }], [\"sleep\", { ms: 200 }]], { toolExecution: \"sequential\" });\nawait run(\"参数校验与未知工具\", [[\"sleep\", { ms: \"很久\" }], [\"nope\", {}]]);\nawait run(\"钩子：拦截与改写\", [[\"sh\", { cmd: \"rm -rf /\" }], [\"sh\", { cmd: \"ls\" }]], {\n  beforeToolCall: async ({ args }) => ((args as any).cmd.startsWith(\"rm\") ? { block: true, reason: \"策略禁止 rm\" } : undefined),\n  afterToolCall: async ({ result }) => ({ content: [{ type: \"text\", text: (result.content[0] as any).text + \" [已审计]\" }] }),\n});\nEOF\nnode scratch/l07.ts": "== 并行（默认）\n   [0ms] sleep(300) 开始\n   [0ms] sleep(200) 开始\n   [200ms] sleep(200) 结束\n   [300ms] sleep(300) 结束\n   结果 sleep: ok\n   结果 sleep: ok\n   总耗时约 300ms\n== 顺序执行\n   [0ms] sleep(300) 开始\n   [300ms] sleep(300) 结束\n   [300ms] sleep(200) 开始\n   [500ms] sleep(200) 结束\n   结果 sleep: ok\n   结果 sleep: ok\n   总耗时约 500ms\n== 参数校验与未知工具\n   结果 sleep: 错误 Validation failed for tool \"sleep\": ⏎   - ms: must be number ⏎  ⏎ Received argum\n   结果 nope: 错误 Tool nope not found\n   总耗时约 0ms\n== 钩子：拦截与改写\n   结果 sh: 错误 策略禁止 rm\n   结果 sh: (执行了 ls) [已审计]\n   总耗时约 0ms"
}