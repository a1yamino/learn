{
"cat > pi-mono/scratch/l13.ts <<'EOF'\nimport { mkdtempSync, readFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { SessionManager } from \"@earendil-works/pi-coding-agent\";\n\nconst dir = mkdtempSync(join(tmpdir(), \"l13-\"));\nconst sm = SessionManager.create(dir, join(dir, \"sessions\"));\nconst user = (t: string) => ({ role: \"user\" as const, content: t, timestamp: Date.now() });\nconst asst = (t: string) => ({ role: \"assistant\" as const, content: [{ type: \"text\" as const, text: t }], api: \"faux\", provider: \"faux\", model: \"faux-1\",\n  usage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } }, stopReason: \"stop\" as const, timestamp: Date.now() });\n\nsm.appendModelChange(\"faux\", \"faux-1\");\nconsole.log(\"只有设置条目时文件存在吗？\", sm.getSessionFile() ? (() => { try { readFileSync(sm.getSessionFile()!); return \"是\"; } catch { return \"否\"; } })() : \"-\");\nconst u1 = sm.appendMessage(user(\"用 Python 写快排\"));\nconst a1 = sm.appendMessage(asst(\"def quicksort(xs): ...\"));\nsm.appendMessage(user(\"改成原地排序\"));\nsm.appendMessage(asst(\"def quicksort(xs, lo, hi): ...\"));\n\n// 回到 a1，换一个方向（分支）\nsm.branch(a1);\nsm.appendMessage(user(\"改用 Rust\"));\nsm.appendMessage(asst(\"fn quicksort<T: Ord>(v: &mut [T]) { ... }\"));\n\nconst lines = readFileSync(sm.getSessionFile()!, \"utf8\").trim().split(\"\\n\").map((l) => JSON.parse(l));\nconsole.log(`\\nJSONL 共 ${lines.length} 行：`);\nfor (const e of lines) console.log(\" \", e.type.padEnd(13), (e.id ?? \"\").padEnd(9), \"parent=\" + (e.parentId ?? \"null\").padEnd(9), e.message ? `${e.message.role}: ${JSON.stringify(e.message.content).slice(0, 30)}` : e.type === \"session\" ? `version=${e.version}` : \"\");\n\nconst label = (id: string) => { const e: any = sm.getEntry(id); return e.message ? `${e.message.role}: ${(typeof e.message.content === \"string\" ? e.message.content : e.message.content[0].text).slice(0, 24)}` : e.type; };\nconst print = (nodes: any[], depth = 0) => { for (const n of nodes) { console.log(\"  \" + \"  \".repeat(depth) + \"└ \" + label(n.entry.id)); print(n.children, depth + 1); } };\nconsole.log(\"\\n树：\");\nprint(sm.getTree());\n\nconsole.log(\"\\n当前分支发给模型的消息：\");\nfor (const m of sm.buildSessionContext().messages as any[]) console.log(\"  \", m.role, \"|\", (typeof m.content === \"string\" ? m.content : m.content[0].text).slice(0, 30));\n\nconst reopened = SessionManager.open(sm.getSessionFile()!, join(dir, \"sessions\"));\nconsole.log(\"\\n重新打开后 leaf 指向:\", label(reopened.getLeafId()!), \"| 条目数\", reopened.getEntryCount());\nEOF\ncd pi-mono/scratch && node l13.ts": "只有设置条目时文件存在吗？ 否\n\nJSONL 共 8 行：\n  session       01a16317-0bc0-738a-990a-64a734caf520 parent=null      version=3\n  model_change  04a095d4  parent=null      \n  message       dd299d49  parent=04a095d4  user: \"用 Python 写快排\"\n  message       4f0a19cc  parent=dd299d49  assistant: [{\"type\":\"text\",\"text\":\"def qu\n  message       7d45dd5a  parent=4f0a19cc  user: \"改成原地排序\"\n  message       7bb20709  parent=7d45dd5a  assistant: [{\"type\":\"text\",\"text\":\"def qu\n  message       1a8fcddf  parent=4f0a19cc  user: \"改用 Rust\"\n  message       af60554f  parent=1a8fcddf  assistant: [{\"type\":\"text\",\"text\":\"fn qui\n\n树：\n  └ model_change\n    └ user: 用 Python 写快排\n      └ assistant: def quicksort(xs): ...\n        └ user: 改成原地排序\n          └ assistant: def quicksort(xs, lo, hi\n        └ user: 改用 Rust\n          └ assistant: fn quicksort<T: Ord>(v: \n\n当前分支发给模型的消息：\n   user | 用 Python 写快排\n   assistant | def quicksort(xs): ...\n   user | 改用 Rust\n   assistant | fn quicksort<T: Ord>(v: &mut [\n\n重新打开后 leaf 指向: assistant: fn quicksort<T: Ord>(v:  | 条目数 7"
