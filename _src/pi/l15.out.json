"cat > pi-mono/scratch/l15.ts <<'EOF'\nimport { fauxAssistantMessage, fauxToolCall } from \"@earendil-works/pi-ai/compat\";\nimport { fauxSession } from \"./faux-session.ts\";\n\n// 一个项目扩展：注册工具、注册命令、拦截危险命令、改写输入、保存状态\nconst extension = `\nimport { Type } from \"typebox\";\nexport default function (pi) {\n  let calls = 0;\n  pi.registerTool({\n    name: \"today\", label: \"today\", description: \"返回今天的日期\",\n    parameters: Type.Object({}),\n    async execute() { calls++; return { content: [{ type: \"text\", text: \"2026-10-22\" }], details: undefined }; },\n  });\n  pi.registerCommand(\"stats\", {\n    description: \"显示扩展统计\",\n    handler: async (_args, ctx) => { console.log(\"[/stats] today 被调用\", calls, \"次；当前模型\", ctx.model?.id); },\n  });\n  pi.on(\"tool_call\", async (event) => {\n    if (event.toolName === \"bash\" && /\\\\brm\\\\s+-rf\\\\b/.test(event.input.command)) return { block: true, reason: \"guard 扩展：禁止 rm -rf\" };\n  });\n  pi.on(\"input\", async (event) => {\n    if (event.text.startsWith(\"!!\")) return { action: \"transform\", text: \"请用一句话回答：\" + event.text.slice(2) };\n  });\n  pi.on(\"agent_settled\", async () => { pi.appendEntry(\"guard-stats\", { calls }); });\n}`;\n\nconst { session } = await fauxSession([\n  fauxAssistantMessage([fauxToolCall(\"today\", {}), fauxToolCall(\"bash\", { command: \"rm -rf build\" })], { stopReason: \"toolUse\" }),\n  fauxAssistantMessage(\"今天是 2026-10-22，删除被拒绝了。\"),\n], { files: { \".pi/extensions/guard.ts\": extension } });\n\nconsole.log(\"活动工具:\", session.agent.state.tools.map((t) => t.name).join(\", \"));\nawait session.prompt(\"!!今天几号？顺便清理 build\");\nfor (const m of session.messages as any[]) {\n  if (m.role === \"user\") console.log(\"user       \", m.content[0].text);\n  if (m.role === \"toolResult\") console.log(\"toolResult \", m.toolName, m.isError ? \"(错误)\" : \"\", m.content[0].text);\n}\nawait session.prompt(\"/stats\");\nconst custom = session.sessionManager.getEntries().filter((e: any) => e.type === \"custom\");\nconsole.log(\"custom 条目:\", JSON.stringify(custom.map((e: any) => ({ customType: e.customType, data: e.data }))));\nconsole.log(\"/stats 产生了发给模型的消息吗？\", session.messages.some((m: any) => m.role === \"user\" && JSON.stringify(m.content).includes(\"stats\")));\nsession.dispose();\nEOF\ncd pi-mono/scratch && node l15.ts": "活动工具: read, bash, edit, write, today\nuser        请用一句话回答：今天几号？顺便清理 build\ntoolResult  today  2026-10-22\ntoolResult  bash (错误) guard 扩展：禁止 rm -rf\n[/stats] today 被调用 1 次；当前模型 faux-1\ncustom 条目: [{\"customType\":\"guard-stats\",\"data\":{\"calls\":1}}]\n/stats 产生了发给模型的消息吗？ false",
"cd pi-mono/packages/coding-agent/examples/extensions && ls | head -30 && ls | wc -l": "README.md\nauto-commit-on-exit.ts\nbash-spawn-hook.ts\nbookmark.ts\nborder-status-editor.ts\nbuilt-in-tool-renderer.ts\nclaude-rules.ts\ncommands.ts\nconfirm-destructive.ts\ncustom-compaction.ts\ncustom-footer.ts\ncustom-header.ts\ncustom-provider-anthropic\ncustom-provider-gitlab-duo\ndebug-provider.ts\ndirty-repo-guard.ts\ndoom-overlay\ndynamic-resources\ndynamic-tools.ts\nentry-renderer.ts\nevent-bus.ts\nfile-trigger.ts\ngit-checkpoint.ts\ngit-merge-and-resolve.ts\ngithub-issue-autocomplete.ts\ngondolin\nhandoff.ts\nhello.ts\nhidden-thinking-label.ts\ninline-bash.ts\n80"
